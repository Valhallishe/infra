[Unit]
Description=Inbuxa containers
Requires=docker.service
Wants=nixarchserver-awg.service
After=docker.service nixarchserver-awg.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@dataDir@
RuntimeDirectory=infra-inbuxa
RuntimeDirectoryMode=0700
ExecStartPre=@decrypt@
ExecStart=/usr/bin/docker compose up -d --no-build --pull never
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
