[Unit]
Description=Inbuxa containers
Requires=docker.service awg-quick@infra0.service
After=docker.service awg-quick@infra0.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/docker/inbuxa
ExecStart=/usr/bin/docker compose up -d --no-build --pull never
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
